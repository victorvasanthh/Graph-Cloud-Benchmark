# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---- dataset: downloaded, not vendored ----
data/*
!data/.gitkeep
!data/README.md

# ---- generated outputs are committed, working files are not ----
results/raw/*.tmp
results/**/*.partial

# Smoke runs are 1-iteration feasibility probes, not measurements. They prove
# the plumbing works and nothing else. They are deliberately NOT committed: a
# file under results/raw is the record of a real run, and a smoke artifact
# sitting beside one is an invitation to read it as data. The `smoke-` prefix
# comes from run_suite.sh, which stamps it onto every artifact of a --smoke run.
results/raw/*smoke-*
results/summary/*smoke-*
charts/*smoke-*
docs/*smoke-*

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
