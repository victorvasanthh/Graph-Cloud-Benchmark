{
  // GitHub Codespaces definition. This is the only environment the
  // containerised parts of this benchmark are meant to run in; nothing here
  // expects Docker on a local machine.
  //
  // The image is built from a local Dockerfile rather than pulled directly.
  // See .devcontainer/Dockerfile: the upstream image carries a Yarn APT source
  // whose signing key no longer verifies, which kills the docker-in-docker
  // feature install and with it Codespace creation. The repair has to happen
  // before features run, and a Dockerfile is the only stage that early.
  "name": "graph-cloud-benchmark",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // docker-in-docker, deliberately, rather than docker-outside-of-docker.
  // The benchmark client connects to bolt://localhost:7687 and friends. With
  // a nested daemon, published container ports land on *this* container's
  // localhost, which is what the harness expects. Sharing the host socket
  // would publish them on the host instead, and every connection would be
  // refused for reasons that look nothing like the real cause.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },

  // The 2-core / 8 GB machine is sufficient *because targets are measured one
  // at a time*: 1 vCPU and 2 GB for the database under test, the rest for the
  // nested daemon, the client and the OS. Running all four at once would need
  // 4 vCPU and 8 GB and does not fit - see scripts/run_suite.sh.
  //
  // Raising these values moves the Codespace to a larger, faster-billing
  // machine type. Do not raise them without deciding that deliberately.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Runs after features are installed. Kept in a script so it can report what
  // failed rather than collapsing a multi-step setup into one shell line, and
  // so that a transient dataset download failure leaves a usable Codespace
  // instead of an unusable one.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
