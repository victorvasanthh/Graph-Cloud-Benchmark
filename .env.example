# =============================================================================
# Copy to .env and fill in.  .env is gitignored and must never be committed.
#   cp .env.example .env
# =============================================================================

# ---- CognoDB Cloud (free c0 instance) -------------------------------------
# From https://console.cognodb.com after creating a free instance.
# The password is displayed EXACTLY ONCE at creation time - save it immediately.
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
COGNODB_REGION=

# ---- Neo4j AuraDB Free (managed-cloud calibration anchor) -----------------
# From https://console.neo4j.io - downloaded as a .txt credentials file.
AURA_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=
AURA_REGION=

# ---- Self-hosted, resource-capped containers ------------------------------
# Started by `make up`. Passwords are local-only and generated by you;
# they are still read from the environment so no credential lives in source.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

ARANGO_URL=http://localhost:8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=
